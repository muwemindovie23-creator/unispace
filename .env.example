# ---------------------------------------------------------------------------
# UniSpace environment. Copy to .env for local development.
# NEVER commit a real .env file. Secrets belong in the hosting provider's
# environment settings, not in the repository.
# ---------------------------------------------------------------------------

# Neon PostgreSQL. Create a project at https://console.neon.tech, then take
# both strings from the connection details panel:
#   DATABASE_URL        -> the POOLED string (host contains "-pooler")
#   DIRECT_DATABASE_URL -> the DIRECT string, used by prisma migrate
#
# Keep the query parameters below on both strings. They are not cosmetic:
#   connect_timeout=30   Neon suspends idle computes. The 5s default is too
#                        short for a cold start and fails with Prisma P1001.
#   pool_timeout=60      `next build` prerenders with several parallel workers,
#                        each holding its own Prisma connection pool.
#   connection_limit=5   Keeps the total across those workers sane.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/unispace?sslmode=require&connect_timeout=30&pool_timeout=60&connection_limit=5"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/unispace?sslmode=require&connect_timeout=30"

# 32+ random characters. Keys session cookies, CSRF tokens, anonymous poll
# ballot hashes and IP hints. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every administrator out and resets anonymous vote identifiers.
AUTH_SECRET=""

# Public origin. Used for absolute URLs, cookie security and origin checking.
APP_URL="http://localhost:3000"
